# Supabase — chave pública (anon/publishable). Segura para expor no client,
# mas mantenha o arquivo .env real fora do Git (veja .gitignore).
SUPABASE_PROJECT_ID="your-project-ref"
SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
SUPABASE_URL="https://your-project-ref.supabase.co"

# Mesmas variáveis, expostas ao bundle do client via prefixo VITE_
VITE_SUPABASE_PROJECT_ID="your-project-ref"
VITE_SUPABASE_PUBLISHABLE_KEY="your-anon-public-key"
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# Variáveis somente de servidor (NUNCA prefixar com VITE_, nunca commitar valor real):
# SUPABASE_SERVICE_ROLE_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# MP_ACCESS_TOKEN=
